<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Shop Acc Roblox</title>
  <style>
    body {
      font-family: Arial;
      background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
      color: white;
      text-align: center;
    }

    h1 {
      margin: 20px;
      color: #00ffcc;
    }

    .container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    .card {
      background: #111;
      border-radius: 15px;
      padding: 15px;
      margin: 15px;
      width: 250px;
      box-shadow: 0 0 10px #00ffcc;
      transition: 0.3s;
    }

    .card:hover {
      transform: scale(1.05);
    }

    img {
      width: 100%;
      border-radius: 10px;
    }

    button {
      margin-top: 10px;
      padding: 10px;
      border: none;
      border-radius: 8px;
      background: #00ffcc;
      color: black;
      cursor: pointer;
      font-weight: bold;
    }

    button:hover {
      background: #00ccaa;
    }
  </style>
</head>

<body>

<h1>🔥 SHOP ACC ROBLOX 🔥</h1>

<div class="container">

  <div class="card">
    <img src="https://tr.rbxcdn.com/default-avatar" alt="">
    <h2>Acc VIP</h2>
    <p>💰 1000 Robux</p>
    <p>Giá: 50k</p>
    <button onclick="window.location.href='https://zalo.me/'">Mua ngay</button>
  </div>

  <div class="card">
    <img src="https://tr.rbxcdn.com/default-avatar" alt="">
    <h2>Acc Pro</h2>
    <p>🔥 Nhiều skin xịn</p>
    <p>Giá: 100k</p>
    <button onclick="window.location.href='https://zalo.me/'">Mua ngay</button>
  </div>

</div>

</body>
</html>
